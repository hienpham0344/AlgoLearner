{
  "info": {
    "name": "AlgoLearner 4.1–4.6 local PostgreSQL smoke",
    "description": "Disposable local integration smoke. OTP lookup requires the local SMTP fixture; never target production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Backend status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"success envelope\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "pm.test(\"real backend\", function () { pm.expect(pm.response.json().data.source).to.eql(\"backend\"); });"
            ]
          }
        }
      ]
    },
