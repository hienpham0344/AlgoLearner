{
  "name": "algolearner-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode auth-demo",
    "dev:auth-demo": "vite --mode auth-demo",
    "dev:backend-mock": "vite --mode backend-mock",
    "dev:lessons-demo": "vite --mode lessons-demo",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.lessons-e2e.json --pretty false",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:lessons": "playwright test e2e/lessons.spec.ts e2e/lessons-live.spec.ts",
    "test:e2e:coverage": "playwright test && node scripts/summarize-e2e-coverage.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "lucide-react": "^0.475.0",
    "marked": "^18.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.0.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.7",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
