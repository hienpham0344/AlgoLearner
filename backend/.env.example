# Optional mock-mode settings. No database or JWT secret required.
SPRING_PROFILES_ACTIVE=mock,dev
AVATAR_DIRECTORY=./data/avatars
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_PIXELS=16000000

# Required outside mock,dev / mock,test. Use your provider's exact issuer and audience.
# JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# JWT_AUDIENCE=authenticated
# JWT_JWK_SET_URI=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Real 4.1 auth signs RS256 tokens with a private PKCS#8 PEM file.
# JWT_ISSUER=https://auth.example.com
# JWT_AUDIENCE=algolearner
# JWT_SIGNING_PRIVATE_KEY_PATH=/secure/path/auth-private-key.pem
# SMTP_HOST=localhost
# SMTP_PORT=1025
# AUTH_MAIL_FROM=no-reply@algolearner.local
# Optional fixed administrator (all three must be set together):
# ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=<bcrypt-hash>

# Optional standalone JDBC check; never used by mock APIs.
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
