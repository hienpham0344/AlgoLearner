# Spring Boot owns authentication; Supabase provides PostgreSQL persistence.
# Copy to backend/.env only if that file does not already exist. Never commit real secrets.
SPRING_PROFILES_ACTIVE=internal-auth

# Supabase Connect > Session pooler (port 5432). Copy the actual host/username.
# Password goes only in DB_PASSWORD. Do not put it in the JDBC URL.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=
# Keep the default migration track for databases created by internal-auth.
# Databases already migrated with main's auth_module_schema.sql must use
# FLYWAY_LOCATIONS=classpath:db/main-auth before starting this backend.
# FLYWAY_LOCATIONS=classpath:db/migration

# Generate once (for example: openssl rand -hex 32) and retain across restarts/pulls.
JWT_SECRET=
# Generate once with `openssl rand -base64 32`; keep across restarts until all issued OTPs expire.
OTP_HMAC_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
INTERNAL_JWT_ISSUER=https://algolearner.local

# Gmail sender and Google App Password, retained across restarts/pulls.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

AVATAR_DIRECTORY=./data/avatars
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_PIXELS=16000000
# AVATAR_DIRECTORY retains legacy local avatars; new uploads use the private bucket below.
# URL is the project origin, e.g. https://PROJECT_REF.supabase.co (no /storage/v1 suffix).
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=learning-private
FILE_MAX_BYTES=20971520
# clamd TCP endpoint reachable only by the backend; missing/unavailable scanner rejects finalization.
FILE_SCANNER_HOST=
FILE_SCANNER_PORT=3310
FILE_SCANNER_TIMEOUT_MS=30000
# ALGOLEARN_EMAIL_PORT=8080
